//Calcula el coste final de una compra al aplicarle un descuento del 15%
Algoritmo Descuento
	Definir precio Como Entero
	Definir precioDescontado Como Real
	
	Escribir "Ingresa el total de compra: "
	Leer precio
	
	precioDescontado <- precio - precio * 0.15
	
	Escribir "tu compra vale: $", precioDescontado, " con el descuento del 15%"
	
FinAlgoritmo